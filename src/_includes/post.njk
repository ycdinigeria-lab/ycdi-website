---
layout: base.njk
ogType: article
---
{% set cleanPath = page.url | cleanUrl %}
{% set shareUrl = site.url + cleanPath %}
{% set catName = category or "General" %}
<article class="post">
  <div class="pagehero posthero">
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb"><a href="index.html">Home</a> <span aria-hidden="true">/</span> <a href="blog.html">Blog</a> <span aria-hidden="true">/</span> <a href="blog-category-{{ catName | catSlug }}.html">{{ catName }}</a></nav>
      <h1>{{ title }}</h1>
      {% if excerpt %}<p class="lead">{{ excerpt }}</p>{% endif %}
      <p class="postmeta">{% if author %}<span class="by">By {{ author }}</span><span aria-hidden="true">&middot;</span>{% endif %}<time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time><span aria-hidden="true">&middot;</span>{{ page.inputPath | readingTime }} min read{% if updated %}<span aria-hidden="true">&middot;</span>Updated <time datetime="{{ updated | isoDate }}">{{ updated | readableDate }}</time>{% endif %}</p>
    </div>
  </div>

  <div class="section postmain">
    <div class="wrap">
      {% if featuredImage %}<figure class="postfig"><img src="{{ featuredImage }}" alt="{{ featuredImageAlt or '' }}" width="1200" height="675" fetchpriority="high"></figure>{% endif %}

      <div class="post-body">
        {{ content | safe }}
      </div>

      <div class="postfoot">
        {% if tags and tags.length %}
        <p class="topics"><span class="lbl">Topics</span>{% for t in tags %}<span class="topic">{{ t }}</span>{% endfor %}</p>
        {% endif %}
        <div class="share" data-share data-title="{{ title }}" data-url="{{ shareUrl }}">
          <span class="lbl">Share this article</span>
          <div class="sharebtns">
            <a href="https://wa.me/?text={{ (title + ' ' + shareUrl) | urlencode }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.6-5.2A8.5 8.5 0 1 1 21 11.5z"/></svg>WhatsApp</a>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ shareUrl | urlencode }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 22v-8h3l1-4h-4V8c0-1 .3-2 2-2h2V2.1C18.7 2 17.4 2 16 2c-3 0-5 1.8-5 5.2V10H8v4h3v8h2z"/></svg>Facebook</a>
            <a href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&amp;url={{ shareUrl | urlencode }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 3h3l-7 8 8 10h-6l-5-6-5 6H2l7-9L1 3h6l4 5 6-5z"/></svg>X</a>
            <a href="mailto:?subject={{ title | urlencode }}&amp;body={{ shareUrl | urlencode }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>Email</a>
            <button type="button" class="copylink" data-copy><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg><span data-copy-label>Copy link</span></button>
          </div>
          <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
        </div>
      </div>

      {% if gallery and gallery.length %}
      <section class="postgallery" aria-label="Photo gallery">
        <h2>Gallery</h2>
        <div class="galpage" data-lightbox>
          {% for g in gallery %}{% if g.image %}
          <figure class="gcell"><img src="{{ g.image }}" alt="{{ g.alt or g.caption or title }}" loading="lazy" data-caption="{{ g.caption }}">{% if g.caption %}<figcaption>{{ g.caption }}</figcaption>{% endif %}</figure>
          {% endif %}{% endfor %}
        </div>
      </section>
      {% endif %}
    </div>
  </div>
</article>

{% set more = collections.posts | relatedPosts(page.url, catName, 3) %}
{% if more.length %}
<section class="section bg-off morepost">
  <div class="wrap">
    <div class="morehead">
      <h2>More from the blog</h2>
      <a class="textlink" href="blog.html">All posts <svg class="ar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h13M12 6l6 6-6 6"/></svg></a>
    </div>
    <div class="postgrid">
      {% for post in more %}
      {% include "postcard.njk" %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="section final-simple">
  <div class="wrap">
    <h2>There&rsquo;s a place for you here.</h2>
    <p>Whether you want to serve, partner, give or pray, there is a meaningful way to be part of YCDI.</p>
    <div class="hero-actions">
      <a class="btn btn-white" href="get-involved.html">Get Involved</a>
      <a class="btn btn-ghost-white" href="blog.html">Back to the blog</a>
    </div>
  </div>
</section>
<script src="assets/js/lightbox.js" defer></script>
<script src="assets/js/blog.js?v={{ build }}" defer></script>
