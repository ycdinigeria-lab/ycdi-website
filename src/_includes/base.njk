<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ seoTitle or title or (site.name + " | Raising Godly Leaders, Transforming Generations") }}</title>
<meta name="description" content="{{ seoDescription or excerpt or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:title" content="{{ seoTitle or title or site.name }}">
<meta property="og:description" content="{{ seoDescription or excerpt or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ featuredImage or site.defaultImage }}">
<meta property="og:site_name" content="{{ site.fullName }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seoTitle or title or site.name }}">
<meta name="twitter:description" content="{{ seoDescription or excerpt or site.description }}">
<meta name="twitter:image" content="{{ site.url }}{{ featuredImage or site.defaultImage }}">
<link rel="icon" href="assets/ycdi-crest.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Open+Sans:wght@400;600;700&family=Playfair+Display:ital,wght@1,500;1,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
</head>
<body>
<header>
  <div class="wrap">
    <nav class="nav" aria-label="Primary">
      <a class="brand" href="index.html" aria-label="YCDI home">
        <img src="assets/ycdi-crest.png" alt="YCDI crest">
        <span class="bname">YCDI<span>Young Christian Development Initiative</span></span>
      </a>
      <div class="navlinks" id="menu">
        <a href="index.html">Home</a>
        <a href="about.html">About</a>
        <a href="what-we-do.html">What We Do</a>
        <a href="chapters.html">Chapters</a>
        <a href="blog.html">Blog</a>
        <a href="get-involved.html">Get Involved</a>
        <a href="events.html">Events</a>
        <a class="btn btn-donate" href="get-involved.html#give"><svg class="ar" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21S4 14 4 8.6A3.6 3.6 0 0 1 10.6 6c.6.6 1 .9 1.4 1.6.4-.7.8-1 1.4-1.6A3.6 3.6 0 0 1 20 8.6C20 14 12 21 12 21z"/></svg>Donate</a>
      </div>
      <button class="navtoggle" id="navtoggle" aria-label="Open menu" aria-expanded="false">&#9776;</button>
    </nav>
  </div>
</header>

{{ content | safe }}

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <div class="row"><img src="assets/ycdi-crest.png" alt="YCDI crest"><div class="bname">YCDI<span>Young Christian Development Initiative</span></div></div>
        <p>Raising godly leaders and transforming generations. A registered Nigerian NGO reaching young people across six states through schools, discipleship, mentorship and scholarships.</p>
      </div>
      <nav class="foot-nav" aria-label="Footer">
        <a href="index.html">Home</a>
        <a href="about.html">About</a>
        <a href="what-we-do.html">What We Do</a>
        <a href="for-schools.html">For Schools</a>
        <a href="chapters.html">Chapters</a>
        <a href="leadership.html">Leadership</a>
        <a href="blog.html">Blog</a>
        <a href="gallery.html">Gallery</a>
        <a href="events.html">Events</a>
        <a href="get-involved.html">Get Involved</a>
      </nav>
      <div class="socials" aria-label="Social media">
        <a href="https://www.facebook.com/ycdinigeria" aria-label="YCDI on Facebook"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 22v-8h3l1-4h-4V8c0-1 .3-2 2-2h2V2.1C18.7 2 17.4 2 16 2c-3 0-5 1.8-5 5.2V10H8v4h3v8h2z"/></svg></a>
        <a href="https://www.instagram.com/ycdinigeria" aria-label="YCDI on Instagram"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a>
        <a href="https://www.youtube.com/channel/UC0QLxd_GNELm9yjGug1i4Tg" aria-label="YCDI on YouTube"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 8s-.2-1.5-.8-2.1c-.8-.8-1.7-.8-2.1-.9C16.5 4.8 12 4.8 12 4.8s-4.5 0-7.1.2c-.4 0-1.3.1-2.1.9C2.2 6.5 2 8 2 8s-.2 1.8-.2 3.6v.8C1.8 14.2 2 16 2 16s.2 1.5.8 2.1c.8.8 1.8.8 2.3.9 1.7.2 6.9.2 6.9.2s4.5 0 7.1-.2c.4 0 1.3-.1 2.1-.9.6-.6.8-2.1.8-2.1s.2-1.8.2-3.6v-.8C22.2 9.8 22 8 22 8zM10 15V9l5 3-5 3z"/></svg></a>
        <a href="https://x.com/ycdinigeria" aria-label="YCDI on X"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 3h3l-7 8 8 10h-6l-5-6-5 6H2l7-9L1 3h6l4 5 6-5z"/></svg></a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; 2026 Young Christian Development Initiative. Registered with the Corporate Affairs Commission of Nigeria, CAC/IT/NO 127209.</span>
      <div class="legal">
        <a href="safeguarding.html">Safeguarding</a>
        <a href="governance.html">Governance</a>
        <a href="financial-accountability.html">Financial accountability</a>
        <a href="contact.html">Contact</a>
        <a href="privacy.html">Privacy</a>
        <a href="terms.html">Terms</a>
      </div>
    </div>
  </div>
</footer>
<script>
  var t=document.getElementById('navtoggle');var m=document.getElementById('menu');
  if(t&&m){t.addEventListener('click',function(){var o=m.classList.toggle('open');t.setAttribute('aria-expanded',o);});
  m.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){m.classList.remove('open');t.setAttribute('aria-expanded',false);});});}
</script>
{% block scripts %}{% endblock %}
</body>
</html>
