---
layout: base.njk
permalink: /chapters.html
title: "Our chapters | YCDI across Nigeria"
seoDescription: "YCDI's chapters across Nigeria, and the story of how each one began. Find the chapter nearest to you."
eleventyExcludeFromCollections: true
---
{% set states = chapters.items | chapterStates %}
<main>
  <section class="pagehero">
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb"><a href="index.html">Home</a> <span aria-hidden="true">/</span> Our chapters</nav>
      <h1>Find YCDI near you.</h1>
      <p class="lead">YCDI runs as local chapters, each one a team of volunteers going into schools, running fellowships and walking with students. Here is where we are, and a little of how each chapter began.</p>
    </div>
  </section>

  <section class="section chexplore" data-chapter-explorer>
    <div class="wrap">
      <h2>{{ chapters.items | length }} chapters. {{ states | length }} states. One mission.</h2>
      <p class="chhint">Choose a state to see the chapters there.</p>

      <div class="statechips" role="group" aria-label="Filter chapters by state">
        <button type="button" class="statechip is-active" data-state="all" aria-pressed="true">All states</button>
        {% for s in states %}
        <button type="button" class="statechip" data-state="{{ s.name }}" aria-pressed="false">{{ s.name }} <span class="n">{{ s.count }}</span></button>
        {% endfor %}
      </div>

      <div class="chexplore-grid">
        <div class="ngmap" aria-hidden="true">
          <svg viewBox="{{ nigeriaMap.viewBox }}" xmlns="http://www.w3.org/2000/svg" focusable="false">
            {% for loc in nigeriaMap.locations %}{% set n = states | stateCount(loc.name) %}
            <path d="{{ loc.path }}"{% if n %} class="has" data-state="{{ loc.name }}"{% endif %}><title>{{ loc.name }}{% if n %}: {{ n }} {% if n == 1 %}chapter{% else %}chapters{% endif %}{% endif %}</title></path>
            {% endfor %}
          </svg>
          <p class="mapkey"><span class="sw"></span>States with a YCDI chapter</p>
          <p class="mapcredit">{{ nigeriaMap.credit }}</p>
        </div>

        <div class="chlist" aria-live="polite">
          {% for c in chapters.items %}
          {% set short = c.name | before(',') %}
          <article class="chrow" data-state="{{ c.state | stateKey }}">
            <div class="chrow-top">
              <span class="tag">{{ c.state }}{% if c.since %} &middot; {{ c.since }}{% endif %}</span>
              <h3>{{ short }}</h3>
              <p class="hl">{{ c.headline }}</p>
            </div>
            <dl class="chfacts">
              {% if c.coordinator %}<div><dt>Coordinator</dt><dd>{{ c.coordinator }}</dd></div>{% endif %}
              {% if c.schools %}<div><dt>Schools</dt><dd>{{ c.schools }}</dd></div>{% endif %}
            </dl>
            <div class="chrow-links">
              <a class="textlink" href="chapter-{{ c.name | chapterSlug }}.html">Read the {{ short }} story <svg class="ar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h13M12 6l6 6-6 6"/></svg></a>
              <a class="textlink" href="get-involved.html#volunteer">Volunteer in {{ short }}</a>
            </div>
          </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <section class="section final-simple">
    <div class="wrap">
      <h2>Is there a chapter near you?</h2>
      <p>We are always looking for volunteers to strengthen existing chapters and help open new ones. If you would like to be part of the work in your area, reach out.</p>
      <div class="hero-actions"><a class="btn btn-white" href="get-involved.html#volunteer">Volunteer with us</a><a class="btn btn-ghost-white" href="contact.html">Contact us</a></div>
    </div>
  </section>
</main>
<script src="assets/js/chapters.js?v={{ build }}" defer></script>
